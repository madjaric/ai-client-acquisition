# ─────────────────────────────────────────────
#  AI Client Acquisition System — Environment
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/database.sqlite

# AI Provider (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI Scoring
AI_SCORING_MODEL=claude-sonnet-4-5
# Set to true to log the full AI prompt+response for debugging
AI_SCORING_DEBUG=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────
#  Email — Gmail SMTP via Nodemailer
# ─────────────────────────────────────────────
# Step 1: Enable 2-Factor Authentication on your Google account
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Create an App Password for "Mail" / "Other (Custom)"
# Step 4: Paste the 16-character password below (no spaces)

GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Displayed as sender name in recipient's inbox
GMAIL_FROM_NAME=Your Name or Company

# Retry configuration (optional)
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY_MS=1000

# ─────────────────────────────────────────────
#  Lead Discovery Engine — SerpAPI
# ─────────────────────────────────────────────
# Get your key at: https://serpapi.com (free tier: 100 searches/month)
# Leave blank to use realistic mock data instead.
SERPAPI_KEY=your_serpapi_key_here
